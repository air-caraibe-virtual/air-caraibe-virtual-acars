{
  "name": "air-caraibe-virtual-acars",
  "version": "0.1.12",
  "description": "Air Caraïbe Virtual — ACARS pilote (bêta) · météo METAR",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "author": "Air Caraibe Virtual",
  "license": "UNLICENSED",
  "dependencies": {
    "electron-updater": "^6.8.11",
    "leaflet": "^1.9.4",
    "node-simconnect": "^4.2.1"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.aircaraibevirtual.acars",
    "productName": "Air Caraibe Virtual",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "sim.js",
      "renderer/**/*",
      "package.json",
      "updater.js",
      "board.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Air Caraibe Virtual",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerLanguages": [
        "fr_FR"
      ],
      "language": "1036",
      "artifactName": "air-caraibe-virtual-acars-setup.exe",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "air-caraibe-virtual",
        "repo": "air-caraibe-virtual-acars",
        "releaseType": "release"
      }
    ],
    "generateUpdatesFilesForAllChannels": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/air-caraibe-virtual/air-caraibe-virtual-acars.git"
  }
}
